<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Must be an AppCompat/MaterialComponents theme: AppCompatActivity and
         FloatingActionButton crash at startup with a plain android:Theme.Material. -->
    <style name="Theme.PertoMesh" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/green</item>
    </style>

</resources>
